{
  "name": "cybersec-atria-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node --env-file=.env.local src/db/seed.ts",
    "db:test:rls": "node --env-file=.env.local src/db/run-rls-tests.ts",
    "db:test:auth": "node --env-file=.env.local src/db/run-auth-tests.ts",
    "db:test": "pnpm db:test:rls && pnpm db:test:auth && pnpm db:test:projects && pnpm db:test:views && pnpm db:test:modules && pnpm db:test:admin && pnpm db:test:my-issues && pnpm db:test:team-members && pnpm db:test:appeals",
    "db:test:projects": "node --env-file=.env.local src/db/run-project-tests.ts",
    "test:sanitize": "node --experimental-strip-types src/lib/utils/sanitize-html.test.ts",
    "db:test:views": "node --env-file=.env.local src/db/run-view-tests.ts",
    "db:test:modules": "node --env-file=.env.local src/db/run-module-tests.ts",
    "db:test:admin": "node --env-file=.env.local src/db/run-admin-tests.ts",
    "check:bundle": "node --env-file=.env.local scripts/check-client-bundle.ts",
    "test:e2e": "playwright test",
    "check:tokens": "node scripts/check-tokens.ts",
    "build:verify": "NEXT_DIST_DIR=.next-verify next build",
    "test:email": "node --experimental-strip-types src/lib/email/from.test.ts",
    "db:test:my-issues": "node --env-file=.env.local src/db/run-my-issue-tests.ts",
    "db:test:team-members": "node --env-file=.env.local src/db/run-team-member-tests.ts",
    "db:test:appeals": "node --env-file=.env.local src/db/run-appeal-tests.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-email/components": "^1.0.12",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "^4.2.0",
    "lucide-react": "^1.42.0",
    "next": "15.5.25",
    "nodemailer": "^10.0.2",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.87.0",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
